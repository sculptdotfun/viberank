{
  "name": "viberank-mcp",
  "version": "1.2.0",
  "description": "MCP server for viberank: submit your AI coding usage (Claude Code, Codex, Gemini CLI and more) and read the leaderboard",
  "mcpName": "io.github.sculptdotfun/viberank",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "viberank-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test test/unit.test.mjs",
    "smoke": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "viberank",
    "claude",
    "claude-code",
    "codex",
    "ccusage",
    "usage",
    "leaderboard"
  ],
  "author": "SCULPT",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "files": [
    "dist",
    "README.md",
    "claude_desktop_config.example.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sculptdotfun/viberank.git",
    "directory": "packages/viberank-mcp-server"
  },
  "homepage": "https://www.viberank.app"
}
